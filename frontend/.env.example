# Backend base URL used by the browser.
# Leave empty in development - Vite proxies /api to VITE_API_PROXY_TARGET.
# In production set it to the public API address, e.g. https://api.example.com
VITE_API_URL=

# Where the Vite dev server forwards /api requests.
# By default: http://localhost:<SERVER_PORT from the root .env> - override only if needed.
# VITE_API_PROXY_TARGET=http://localhost:8080

# Name displayed in the navbar and page title - change it for every new app
VITE_APP_NAME=UserBridge
