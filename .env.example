# Copy to .env and fill in:  cp .env.example .env
# --- Application ---------------------------------------------------
APP_FRONTEND_URL=http://localhost:5173
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
PASSWORD_RESET_EXPIRATION_MINUTES=30

# --- JWT -----------------------------------------------------------
# Generate your own: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRATION_DAYS=7
JWT_ISSUER=UserBridge

# --- Database (shared by Spring Boot and compose.yaml) -------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=userbridge
DB_USERNAME=userbridge
DB_PASSWORD=change-me
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
DOCKER_COMPOSE_ENABLED=true

# --- Mail (Gmail SMTP: use an App Password, not your account password)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password
